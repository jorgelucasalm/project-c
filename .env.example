# Supabase — public project settings (safe for the browser bundle)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase — service role key. SERVER-ONLY. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google Calendar OAuth (lib/google-calendar). Create credentials at
# https://console.cloud.google.com/apis/credentials with the Calendar API
# enabled and this redirect URI registered:
#   {NEXT_PUBLIC_SITE_URL}/api/google-calendar/callback
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:3000/api/google-calendar/callback

# Public base URL of this app (used to build absolute redirect/callback URLs)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Notification providers (optional — only needed once a real channel is
# wired into src/services/notifications). Leave empty to keep the default
# "log" provider, which just records deliveries in the notifications table.
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
RESEND_API_KEY=
NOTIFICATION_EMAIL_FROM=

# Used by supabase/functions/lesson-reminders to call back into this app or
# Supabase with elevated privileges. Same value as SUPABASE_SERVICE_ROLE_KEY.
CRON_SECRET=
